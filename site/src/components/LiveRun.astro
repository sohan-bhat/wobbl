---
// A run on its example page, played back from its own results: the question, the command, and the part in
// 3D with the load ramping up (or the temperatures rising over the run's saved times), one live number per
// part and the verdict once it ends. A run that was fixed plays beside the fix chosen under it. A run with a
// scene (its scene.wobbl) plays in the same view: the scene's input ramps from its first value to the value
// the question asked about, and then the slider under the view is free to drag. Before the script runs,
// without WebGL or with reduced motion, the figure shows a still of the view and the final numbers. The
// checks, the other numbers, the charts and summary.txt sit in a closed toggle under it, and the full
// report is a link.
import Term from './Term.astro';
import { picture, publicSize } from '../lib/images';
import { COLOR, metrics, runImages, type Example, type Run } from '../lib/examples';
import { clock, finalValue, firstFix, fmt, meter, pace, panes as panesOf, playFor, type Pane, type StrengthRun } from '../lib/playback';
import { sceneRun } from '../lib/scenes';
import { num, sig } from '../scripts/scene-file.js';
import { url } from '../lib/site';
import '../styles/live-run.css';

// beside: other runs of the example over the same input, shown side by side with run (a board laid out two ways)
// also: other studies of the same command whose view would repeat this one, whose numbers join it under the toggle
interface Props { ex: Example; run: Run; first?: boolean; beside?: Run[]; also?: Run[] }
const { ex, run, first = false, beside = [], also = [] } = Astro.props;
const word = (v: string) => v.toUpperCase();
const checks = (run.outcome.checks ?? []).filter((c) => c.status !== 'skip');
const sc = playFor(ex, run) ? null : sceneRun(run);

// ---- a strength or heat run ----------------------------------------------------------------------
const all = sc ? [] : panesOf(ex, run);
const fix = sc ? -1 : firstFix(all);
const shown = sc ? [] : fix > 0 ? [all[0], all[fix]] : [all[0]];
const lead = sc ? null : all[0].play;

// ---- a scene run -----------------------------------------------------------------------------------
const sp = sc?.play ?? null;
const inp = sp?.input;
const lerpAt = (vs: (number | null)[], p: number) => {
  const a = Math.floor(p), b = Math.min(a + 1, vs.length - 1), k = inp!.between === 'step' ? 0 : p - a;
  const x = vs[a] ?? NaN, y = vs[b] ?? NaN;
  return k ? x + (y - x) * k : x;
};
const sceneText = (v: number, unit: string, d = 3) => `${sig(v, d)}${unit ? ` ${unit}` : ''}`;
const inputText = (v: number) => `${num(v)}${inp!.unit ? ` ${inp!.unit}` : ''}`;
const cap = (x: string) => x[0].toUpperCase() + x.slice(1);
// the scene's panes: the run itself, or the run and the others of its example over the same input, or the
// values along its input that the run compares (wet and dry glass), the one the question asked about first
interface ScenePane { rel: string; name: string; at?: string; src: string; play: NonNullable<typeof sp>; home: number; asked: boolean; verdict: string;
  poster: { src: string; width: number; height: number } | null }
const scenePanes: ScenePane[] = !sc ? [] : beside.length
  ? [run, ...beside].map((r) => { const x = sceneRun(r)!; return { rel: r.rel, name: cap(r.rel.split('/').pop()!.replace(/-/g, ' ')), src: x.src, play: x.play,
    home: x.play.input.home, asked: true, verdict: r.outcome.verdict, poster: x.poster }; })
  : sp!.alts ? (() => {
    const named = sp!.alts!.map((a) => ({ ...a, asked: Math.abs(a.at - inp!.home) < 0.5 }));
    const list = named.some((a) => a.asked) ? [...named.filter((a) => a.asked), ...named.filter((a) => !a.asked)]
      : [{ name: 'As asked', at: inp!.home, asked: true }, ...named];
    return list.map((a) => ({ rel: run.rel, name: a.name, at: inputText(lerpAt(inp!.t, a.at)), src: sc.src, play: sp!, home: a.at,
      asked: a.asked, verdict: run.outcome.verdict, poster: sc.poster }));
  })()
  : [{ rel: run.rel, name: 'As asked', src: sc.src, play: sp!, home: inp!.home, asked: true, verdict: run.outcome.verdict, poster: sc.poster }];
const sceneShown = scenePanes.length > 1 ? [scenePanes[0], scenePanes[1]] : scenePanes;
// a compared value's verdict is its reading against the limit, as the page works it out live
const levelOf = (v: number) => {
  const q = sp?.q;
  if (!q || q.limit === null || !Number.isFinite(v)) return 'info';
  return v > q.limit ? 'fails' : q.named && q.target !== null && v > q.target ? 'marginal' : 'holds';
};
const paneValue = (pn: ScenePane) => (pn.play.q ? lerpAt(pn.play.q.values, pn.home) : NaN);
const paneVerdict = (pn: ScenePane) => {
  if (pn.asked) return pn.verdict;
  const lv = levelOf(paneValue(pn));
  return lv === 'holds' && pn.verdict === 'ok' ? 'ok' : lv === 'info' ? pn.verdict : lv;
};

const kind = sc ? 'scene' : lead!.kind;
const m = sp ? (sp.q ? { lo: sp.q.lo, top: sp.q.top, marks: sp.q.marks } : { lo: 0, top: 1, marks: [] }) : meter(lead!);
const p = sp ? { tag: '', seconds: 4.5, speed: 1, span: 1 } : pace(lead!);
const frac = (v: number) => Math.min(Math.max((v - m.lo) / (m.top - m.lo), 0), 1);
const pct = (v: number) => `${frac(v) * 100}%`;
const unit = sp ? sp.q?.unit ?? '' : kind === 'strength' ? 'MPa' : 'C';
const loads = kind === 'strength' ? (lead as StrengthRun).loads : [];
// each load as the page writes every number, 2,000 N rather than 2000 N
const loadText = loads.map((l) => { const [v, u] = l.split(' '); return Number.isFinite(Number(v)) ? `${fmt(Number(v), Number(v) < 100 ? 1 : 0)} ${u}` : l; }).join(' and ');
// the moment a part passes its limit, when it does: the load at that point (stress scales with it)
// or the time the run itself reported
const eventOf = (pane: Pane) => {
  const q = pane.play;
  if (q.kind === 'strength') {
    if (q.governing_MPa <= q.allowable_MPa) return null;
    const k = q.allowable_MPa / q.governing_MPa;
    const at = loads.length === 1 ? (() => { const [v, u] = loads[0].split(' '); return `${fmt(Number(v) * k, Number(v) * k < 100 ? 1 : 0)} ${u}`; })()
      : `${fmt(k * 100)}% of the load`;
    return { k, text: `${all.length > 1 ? `${pane.name} passes` : 'Passes'} the ${fmt(q.allowable_MPa)} MPa limit at ${at}` };
  }
  return q.cross_s != null ? { k: q.cross_s, text: `Passes ${fmt(q.limit_C)} C at ${clock(q.cross_s)}` } : null;
};
const event = sp ? (sp.event && { k: sp.event.at, text: sp.event.text }) : shown.map(eventOf).find((e) => e) ?? null;
const label = sp ? inp!.label : kind === 'strength' ? 'Load' : 'Time';
const steady = lead?.kind === 'heat' && !lead.transient;
const total = sp ? inputText(lerpAt(inp!.t, inp!.home))
  : kind === 'strength' ? loadText : steady ? 'Steady state' : clock(p.span);
const alt = (name: string) => sp ? `The ${sp.title.toLowerCase()}, as the run left it at ${total}`
  : `Wobbl's ${kind === 'strength' ? 'stress' : 'temperature'} heatmap of the ${ex.title.toLowerCase()}${all.length > 1 ? `, ${name.toLowerCase()}` : ''}`;
// the convergence chart the site keeps for the bracket; a README's own charts fold away in its notes
const extra = run.rel === 'shelf-bracket/output' ? ['bracket-convergence'] : [];
const heatmap = sp ? null : all[0].poster;
// a scene run keeps the charts Wobbl drew for it under the toggle
const charts = sp ? runImages(run).map((i) => i.name).filter((n) => !/setup/.test(n) && publicSize(`/img/${n}.webp`)) : [];

// the readings at the value the question asked about
const qHome = sp?.q ? lerpAt(sp.q.values, inp!.home) : NaN;
const final = sp ? (sp.q ? sig(qHome, sp.q.digits) : '') : '';
const alsoText = sp ? sp.also.map((a, i) => `${i ? a.name : a.name[0].toUpperCase() + a.name.slice(1)} ${sceneText(lerpAt(a.values, inp!.home), a.unit, a.digits)}`).join(', ') : '';
// the toggles beside the load or the input: the bending drawn larger than it is, as on the landing part, and
// small parts of a scene drawn larger so they show
const exag = sp ? sp.exag : kind === 'strength' ? (lead as StrengthRun).exag : 1;
const toggles = [
  ...(exag > 1 ? [{ key: 'bend', text: `Bending ×${exag}`, title: 'Show the bending larger than it is' }] : []),
  ...(sp?.magnify ? [{ key: 'mag', text: `${sp.magnify.label} ×${sp.magnify.factor}`, title: `Show the ${sp.magnify.label.toLowerCase()} larger than it is` }] : []),
];
const rows = sp ? sceneShown.map((pn) => ({ name: pn.name, at: pn.at, v: paneValue(pn), verdict: paneVerdict(pn), finalText: pn.play.q ? sig(paneValue(pn), pn.play.q.digits) : '' }))
  : shown.map((pane) => {
    const q = pane.play;
    return { name: pane.name, at: undefined as string | undefined, v: q.kind === 'strength' ? q.governing_MPa : q.t_max_C, verdict: q.verdict, finalText: finalValue(q) };
  });
const panes = sp ? sceneShown.map((pn) => ({ name: pn.name, pic: pn.poster ? { src: pn.poster.src, srcset: '', width: pn.poster.width, height: pn.poster.height } : null }))
  : shown.map((pane) => ({ name: pane.name, pic: pane.poster ? picture(pane.poster) : null }));
const T0 = sp ? inp!.t[0] : 0, T1 = sp ? inp!.t[inp!.t.length - 1] : 0;
// the slider runs along the input's own value, so equal moves are equal changes even where the saved
// frames sit closer together
const homeT = sp ? (() => { const a = Math.floor(inp!.home), b = Math.min(a + 1, inp!.t.length - 1);
  return inp!.t[a] + (inp!.t[b] - inp!.t[a]) * (inp!.home - a); })() : 0;
const homeAt = sp && T1 !== T0 ? (homeT - T0) / (T1 - T0) : 0;
// the slider moves every pane along the same input; panes that are values along one input have none
const sliding = !!sp && inp!.t.length > 1 && !(sp.alts && !beside.length);
// the choices for the right pane, as buttons, when there are more than two
const choices = sp ? scenePanes.map((pn) => pn.name) : all.map((pane) => pane.name);

const data = JSON.stringify(sp ? {
  kind, fix: scenePanes.length > 1 ? 1 : -1, pace: p, meter: m, unit, loads: [], steady: false, total, title: sp.title.toLowerCase(),
  panes: scenePanes.map((pn) => ({ rel: pn.rel, name: pn.name, at: pn.at, file: pn.src, run: pn.play, home: pn.home, asked: pn.asked,
    event: pn.play.event && { k: pn.play.event.at, text: pn.play.event.text }, final: pn.play.q ? sig(paneValue(pn), pn.play.q.digits) : '', verdict: pn.verdict,
    poster: pn.poster && { src: pn.poster.src, srcset: '', width: pn.poster.width, height: pn.poster.height, alt: alt(pn.name) } })),
} : {
  kind, fix, pace: p, meter: m, unit, loads, steady, total, title: ex.title.toLowerCase(),
  panes: all.map((pane) => {
    const pic = pane.poster ? picture(pane.poster) : null;
    return { rel: pane.rel, name: pane.name, file: pane.file, run: pane.play, event: eventOf(pane), final: finalValue(pane.play),
      poster: pic && { src: pic.src, srcset: pic.srcset, width: pic.width, height: pic.height, alt: alt(pane.name) } };
  }),
}).replace(/</g, '\\u003c');
---
<div class:list={['run', 'lrun-run', { 'lrun-wide': panes.length > 1 }]}>
  <div class="run-steps">
    <div class="run-step"><p class="run-label">You ask</p><p class="run-ask">{run.question}</p></div>
    <div class="run-step"><p class="run-label">Wobbl runs</p><Term code={run.command} /></div>
  </div>
  <div class="run-result">
    <figure class="lrun" data-lrun data-kind={kind} data-panes={panes.length}>
      <div class="lrun-view" data-state="poster">
        <div class="lrun-panes">
          {panes.map((pane, i) => (
            <div class="lrun-pane" data-i={i}>
              {pane.pic && <img class="lrun-poster" src={pane.pic.src} srcset={pane.pic.srcset || undefined}
                                sizes={pane.pic.srcset ? (panes.length > 1 ? '(min-width: 1000px) 640px, 100vw' : '(min-width: 1000px) 46vw, 100vw') : undefined}
                                width={pane.pic.width} height={pane.pic.height} loading={first ? undefined : 'lazy'} fetchpriority={first && i === 0 ? 'high' : undefined}
                                decoding="async" alt={alt(pane.name)} />}
              {panes.length > 1 && <p class="lrun-name" data-name>{pane.name}</p>}
              <span class="lrun-mark" hidden aria-hidden="true"><span class="target"></span>{sp && <span class="peak-tag-v lrun-mark-v" data-mark-v></span>}</span>
            </div>
          ))}
        </div>
        {sp && <div class="probe lrun-probe" hidden aria-hidden="true"><b data-probe-v></b><span data-probe-k></span><span class="x" data-probe-x></span></div>}
        <button type="button" class="btn-outline btn-sm lrun-replay" hidden>Replay</button>
        <p class="viewer-status lrun-status" role="status"></p>
      </div>
      {choices.length > 2 && (
        <div class="lrun-fixes" role="group" aria-label={sp ? 'What plays beside the value asked about' : 'Fixed version beside the part as drawn'}>
          {choices.slice(1).map((name, i) => (
            <button type="button" class="btn-outline btn-sm" data-fix={i + 1} aria-pressed={String(i + 1 === (sp ? 1 : fix))}>{name}</button>
          ))}
        </div>
      )}
      <div class="lrun-read">
        <p class="lrun-clock">
          <span><span class="lrun-k">{label}</span> <span class="lrun-now" data-now>{total}</span><span class="lrun-of" data-of hidden> of {total}</span></span>
          {toggles.length > 0 ? (
            <span class="lrun-toggles">
              {toggles.map((t) => <button type="button" class="btn-outline btn-sm bend" data-toggle={t.key} aria-pressed="true" title={t.title}><span class="bend-box" aria-hidden="true"></span>{t.text}</button>)}
            </span>
          ) : p.tag && <span class="lrun-tag" hidden>{p.tag}</span>}
        </p>
        {sliding && (
          <div class="lrun-slider">
            <input type="range" min={Math.min(T0, T1)} max={Math.max(T0, T1)} step={Math.abs(T1 - T0) / 2000} value={homeT} disabled
                   aria-label={label} aria-valuetext={total} />
            <div class="lrun-ticks lrun-sticks" aria-hidden="true">
              <span style="left: 0">{inputText(T0)}</span>
              {homeAt > 0.12 && homeAt < 0.88 && <span style={`left: ${homeAt * 100}%`}>{inp!.kind === 'input' ? 'asked' : ''}</span>}
              <span style="left: 100%">{inputText(T1)}</span>
            </div>
          </div>
        )}
        {rows.map((row, i) => (
          <div class="lrun-row" data-row={i}>
            {rows.length > 1 && <p class="lrun-row-name"><span data-name>{row.name}</span>{row.at && <span class="lrun-at" data-at>{row.at}</span>}</p>}
            {sp && sp.q && rows.length === 1 && <p class="lrun-row-name lrun-q">{sp.q.name}</p>}
            {(!sp || sp.q) && (
              <div class="lrun-meter" aria-hidden="true">
                <span class="lrun-fill" data-fill data-level={COLOR[row.verdict] ?? 'marginal'} style={`--f: ${frac(row.v)}`}></span>
                {m.marks.map((mk) => <span class="lrun-mk" style={`left: ${pct(mk.at)}`}></span>)}
              </div>
            )}
            <p class="lrun-n"><span data-n>{row.finalText}</span>{unit && <>&nbsp;{unit}</>}</p>
            <p class="vword lrun-verdict" data-verdict={COLOR[row.verdict] ?? 'marginal'} data-word>{word(row.verdict)}</p>
            {(!sp || sp.q) && (
              <div class="lrun-ticks" aria-hidden="true">
                <span style="left: 0">{sp ? sig(m.lo, 3) : kind === 'strength' ? '0' : `${fmt(m.lo)} C air`}</span>
                {m.marks.map((mk) => <span style={`left: ${pct(mk.at)}`}>{mk.text}</span>)}
              </div>
            )}
          </div>
        ))}
        {alsoText && rows.length === 1 && <p class="lrun-also" data-also>{alsoText}</p>}
        {event && <p class="lrun-event" data-event hidden={sp ? inp!.home < event.k : undefined}>{event.text}</p>}
        {steady && <p class="lrun-note">The run solved the steady state, and Wobbl's lumped check of the same sink times the warm up.</p>}
        <p class="visually-hidden" data-said aria-live="polite"></p>
      </div>
      <script type="application/json" data-lrun-data set:html={data}></script>
    </figure>
    {run.report && <p class="run-files"><a href={url(run.report)} data-astro-reload data-astro-prefetch="false">Open the full report</a></p>}
    <details class="lrun-more" data-pagefind-ignore="all">
      <summary>Checks, numbers and charts</summary>
      <p class="run-verdict"><span class="vword" data-verdict={COLOR[run.outcome.verdict] ?? 'marginal'}>{word(run.outcome.verdict)}</span><samp class="run-said" translate="no">{run.outcome.headline}</samp></p>
      <dl class="readout">{metrics(run).map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
      {checks.length > 0 && (
        <ul class="run-checks">{checks.map((c) => <li data-status={c.status}><span class="st">{c.status}</span>{c.name}</li>)}</ul>
      )}
      {[...(heatmap ? [heatmap] : []), ...extra, ...charts].map((name) => {
        const pic = picture(name);
        return <img class="lrun-more-img" src={pic.src} srcset={pic.srcset} sizes="(min-width: 1000px) 46vw, 100vw" width={pic.width} height={pic.height}
                    loading="lazy" decoding="async" alt={name.includes('convergence') ? 'Peak stress at each mesh level, as Wobbl plotted it'
                      : name.includes('history') ? 'Hottest point and average temperature over the run, as Wobbl plotted them'
                      : sp ? `${name.replace(/-/g, ' ')}, as Wobbl plotted it` : alt('As drawn')} />;
      })}
      {run.summary && <Term code={run.summary} lang="text" label="summary.txt" />}
      {[...beside, ...also].map((o) => (
        <>
          <p class="run-verdict"><span class="vword" data-verdict={COLOR[o.outcome.verdict] ?? 'marginal'}>{word(o.outcome.verdict)}</span><samp class="run-said" translate="no">{o.outcome.headline}</samp></p>
          <dl class="readout">{metrics(o).map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
          {o.summary && <Term code={o.summary} lang="text" label={`${o.rel.split('/').pop()} summary.txt`} />}
        </>
      ))}
    </details>
  </div>
</div>

<script>
  import { initLiveRuns } from '../scripts/live-run';
  let stop: (() => void) | null = null;
  document.addEventListener('astro:page-load', () => { stop?.(); stop = initLiveRuns(); });
  document.addEventListener('astro:before-swap', () => { stop?.(); stop = null; });
</script>
