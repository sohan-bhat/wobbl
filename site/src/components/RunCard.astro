---
// One run on an example page: the question, the command and the checks beside the result,
// its verdict and numbers, the suggested fixes, summary.txt folded away and the full report.
import RunImage from './RunImage.astro';
import Term from './Term.astro';
import { COLOR, metrics, type Run } from '../lib/examples';
import { meters, mps, secs } from '../scripts/flight-format';
import { url } from '../lib/site';
import { hasSim } from '../lib/sim';
import { sceneFor } from '../lib/scenes';
import SceneView from './SceneView.astro';
interface Props { run: Run }
const { run } = Astro.props;
const checks = (run.outcome.checks ?? []).filter((c) => c.status !== 'skip');
const sugg = run.fixes.length ? [] : (run.outcome.fixes ?? []).slice(0, 3).map((f) => f.title);
const { model, events = [] } = run.outcome;
// a flight's events have an altitude and a speed, a mechanism's a line of detail
const flightEvents = events.every((e) => e.alt_m !== undefined);
// what the model holds: a motion run's effects, or a mechanism's bodies, joints and freedoms
const held = model?.effects ?? (model?.bodies ? [`${model.bodies} bodies`, `${model.joints} joints`,
  `${model.degrees_of_freedom} degrees of freedom`] : []);
// a run with a 3D scene shows it across the whole width, above the question and the result
const scene = sceneFor(run.rel);
const cap = (s: string) => s[0].toUpperCase() + s.slice(1);
---
<div class:list={['run', { 'run-live': hasSim(run) && !scene, 'run-3d': scene }]}>
  {scene && <div class="run-scene"><SceneView rel={run.rel} /></div>}
  <div class="run-steps">
    <div class="run-step"><p class="run-label">You ask</p><p class="run-ask">{run.question}</p></div>
    <div class="run-step"><p class="run-label">Wobbl runs</p><Term code={run.command} /></div>
    {held.length > 0 && (
      <div class="run-step"><p class="run-label model-label">Modeled {model?.states !== undefined && <span>{model.states} state variables</span>}</p>
        <ul class="effects" aria-label="In the model">{held.map((e) => <li>{e}</li>)}</ul>
      </div>
    )}
    {checks.length > 0 && (
      <div class="run-step"><p class="run-label">Checks</p>
        <ul class="run-checks">{checks.map((c) => <li data-status={c.status}><span class="st">{c.status}</span>{c.name}</li>)}</ul>
      </div>
    )}
    {events.length > 0 && (
      <div class="run-step run-events"><p class="run-label">Events</p>
        <div class="table-scroll" role="region" aria-label="Events" tabindex="0" data-keep>
          <table class="data">
            {flightEvents ? (
              <>
                <thead><tr><th scope="col">Event</th><th scope="col">Time</th><th scope="col">Altitude</th><th scope="col">Speed</th></tr></thead>
                <tbody>
                  {events.map((e) => (
                    <tr><th scope="row">{cap(e.name)}</th><td class="num">{secs(e.t_s)}</td><td class="num">{meters(e.alt_m!)}</td>
                      <td class="num">{e.speed_mps === undefined ? '' : mps(e.speed_mps)}</td></tr>
                  ))}
                </tbody>
              </>
            ) : (
              <>
                <thead><tr><th scope="col">Event</th><th scope="col">Time</th><th scope="col">Detail</th></tr></thead>
                <tbody>
                  {events.map((e) => (
                    <tr><th scope="row">{cap(e.name)}</th><td class="num">{secs(e.t_s)}</td><td>{e.detail}</td></tr>
                  ))}
                </tbody>
              </>
            )}
          </table>
        </div>
      </div>
    )}
  </div>
  <div class="run-result">
    {!scene && <RunImage run={run} sizes="(min-width: 1000px) 46vw, 100vw" controls />}
    <p class="run-verdict"><span class="vword" data-verdict={COLOR[run.outcome.verdict] ?? 'marginal'}>{run.outcome.verdict.toUpperCase()}</span><samp class="run-said" translate="no">{run.outcome.headline}</samp></p>
    <dl class="readout">{metrics(run).map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
    {sugg.length > 0 && (
      <div class="run-sugg"><p class="run-label">{sugg.length === 1 ? 'Suggested fix' : 'Suggested fixes'}</p>
        <ul>{sugg.map((t) => <li>{t}</li>)}</ul>
      </div>
    )}
    <details class="run-summary" data-pagefind-ignore="all"><summary>summary.txt</summary><Term code={run.summary} lang="text" label="summary.txt" /></details>
    {run.report && <p class="run-files"><a href={url(run.report)} data-astro-reload data-astro-prefetch="false">Open the full report</a></p>}
  </div>
</div>
