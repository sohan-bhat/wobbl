---
// The 3D part in the landing page's hero: the viewer with its static poster, and the
// controls under it. scripts/hero.ts drives it and scripts/viewer.js draws it.
// The numbers come from public/data/cast-motor-mount.json (scripts/export_site_part.py) and are
// filled in here at build time, so the reading is right before any script runs. The page links
// the part's mesh and its peak table by the content hash in their file names.
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import { url } from '../lib/site';
import BENDING from '../data/bending.json';
import { poster, posterSet } from '../lib/poster';
import { WORD, fmt, reading, widths, type PartData } from '../scripts/reading';

const man: PartData & { governing_MPa: number } =
  JSON.parse(readFileSync(resolve(process.cwd(), 'public/data/cast-motor-mount.json'), 'utf-8'));
const MAX = 4000;
// the bending factor this part is drawn at everywhere on the site
const BEND = BENDING['cast-motor-mount'];
const r = reading(man, man.load_N, man.default_peak_MPa / man.load_N);
const w = widths(man, MAX);
// the browser reads what it needs of the manifest from the page instead of fetching it
const { name, file, load_N, allowable_MPa, target_sf, pull, mesh, layout, default_peak_MPa, peak_range_MPa, peak_nodes } = man;
const converged = man.converged.map(({ azimuth_deg, elevation_deg, converged_MPa, superposed_MPa, difference_pct }) =>
  ({ azimuth_deg, elevation_deg, converged_MPa, superposed_MPa, difference_pct }));
const json = JSON.stringify({ name, file, load_N, allowable_MPa, target_sf, pull, mesh, layout, default_peak_MPa,
  peak_range_MPa, peak_nodes, converged }).replace(/</g, '\\u003c');
// The camera Wobbl's heatmap of this part was drawn with (report/render.py: 1600 x 1000, 30 degrees
// zoomed 1.15 times), the crop scripts/build_site_images.py took from it, and its color scale, so
// the 3D view can start exactly where the poster is and fade in without a jump.
const posterCamera = JSON.stringify({
  position: [-241.2442, 288.7442, 248.9954], target: [0, 47.5, 56], fov: 30 / 1.15,
  frame: [1600, 1000], crop: [355, 51, 1170, 949], clim: man.governing_MPa,
});
---
<figure class="hero-part" style={`--readout-w: ${w.peak + 4}ch`}>
  <div class="viewer" id="viewer" data-state="poster" data-file={url(`data/${man.file}`)} data-peaks={url(`data/${man.peaks}`)}>
    <img class="viewer-poster" src={poster} srcset={posterSet} sizes="(min-width: 1000px) 56vw, 100vw"
         width="1170" height="949" fetchpriority="high" data-camera={posterCamera}
         alt="Stress heatmap of a sand cast aluminum motor mount. The hottest spot, labeled 124 MPa, is where the rib tip meets the upright." />
    <p class="viewer-status" role="status" aria-live="polite"></p>
    <p class="visually-hidden" id="part-said" aria-live="polite"></p>
    <p class="viewer-note" id="part-note" hidden></p>
    <div class="probe" hidden></div>
    <div class="peak-tag" hidden><span class="target" aria-hidden="true"></span><span class="peak-tag-v"></span></div>
    <div class="load-tag" hidden></div>
    <div class="pull-grip" hidden aria-hidden="true"></div>
    <div class="hint-hand" hidden aria-hidden="true">
      <svg viewBox="0 0 24 26" width="24" height="26"><circle class="hint-ring" cx="5" cy="4" r="4" /><path d="M5 4v15.5l4.1-3.7 2.9 6.4 2.7-1.2-2.9-6.3h5.6Z" /></svg>
    </div>
    <button type="button" class="btn-outline btn-sm bend" id="bend" aria-pressed="true" data-bend={BEND}><span class="bend-box" aria-hidden="true"></span>Bending &times;{BEND}</button>
  </div>
  <div class="part-controls">
    <div class="control">
      <label for="load">Load <output id="load-out" for="load">{fmt(man.load_N)}&nbsp;N</output></label>
      <input type="range" id="load" name="load" autocomplete="off" min="0" max={MAX} step="10" value={man.load_N}>
      <div class="legend" aria-hidden="true">
        <div class="legend-bar"><span class="legend-target"></span><span class="legend-peak" id="legend-peak" style={`left: ${Math.min(r.peak / man.allowable_MPa, 1) * 100}%`}></span></div>
        <div class="legend-ticks"><span>0</span><span>{fmt(man.allowable_MPa / man.target_sf, 1)} target</span><span>{fmt(man.allowable_MPa)}&nbsp;MPa limit</span></div>
      </div>
    </div>
    <div class="live">
      <p class="live-n"><span id="r-peak">{fmt(r.peak, 1)}</span>&nbsp;MPa</p>
      <p class="vword" id="verdict-word" data-verdict={r.verdict} aria-live="polite">{WORD[r.verdict]}</p>
    </div>
  </div>
  <script is:inline type="application/json" id="part-data" set:html={json}></script>
</figure>

<style>
  /* the load, in a box as wide as "4,000 N" */
  .control #load-out { min-width: 0; width: 7ch; white-space: nowrap; }

  /* The hit area over the whole arrow, a pill wider than the arrow that turns with it. It takes the
     drag that points the load, so the camera never orbits from there, and a touch on it never scrolls. */
  .pull-grip {
    position: absolute; left: 0; top: 0; z-index: 2; transform-origin: 0 50%; border-radius: 999px;
    cursor: grab; touch-action: none; -webkit-tap-highlight-color: transparent;
  }
  .pull-grip[data-turning] { cursor: grabbing; }
  .pull-grip[hidden], .viewer:not([data-state="live"]) .pull-grip { display: none; }

  /* The pointer that shows, on the first loop of the idle animation, that the arrow can be dragged */
  .hint-hand {
    position: absolute; left: 0; top: 0; z-index: 2; margin: -4px 0 0 -5px; pointer-events: none;
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.6));
  }
  .hint-hand[hidden] { display: none; }
  .hint-hand svg { display: block; overflow: visible; }
  .hint-hand path { fill: var(--fg); stroke: var(--ink); stroke-width: 1.4; stroke-linejoin: round; }
  .hint-ring { fill: none; stroke: var(--yellow); stroke-width: 2; }

  /* A note over the part, only near directions where the mesh reads off */
  .viewer-note {
    position: absolute; left: 12px; right: 12px; bottom: 12px; z-index: 2; margin: 0; width: fit-content;
    max-width: min(46ch, calc(100% - 24px)); padding: 8px 10px; background: var(--bg); border: 1px solid var(--line-2);
    font-size: 0.85rem; line-height: 1.45; color: var(--fg-2); pointer-events: none;
  }
  .viewer-note[hidden] { display: none; }

  /* The peak marker sits on the peak and the script places its value beside it, and the load label by
     its corner, both kept inside the view and clear of each other. Both have fixed widths, sized for
     their widest text, so a new value never changes their size. */
  .peak-tag { display: block; width: 0; height: 0; transform: none; }
  .peak-tag[hidden], .load-tag[hidden] { display: none; }
  .peak-tag .target { position: absolute; left: -9px; top: -9px; }
  .peak-tag-v {
    position: absolute; left: 0; top: 0; white-space: nowrap;
    box-sizing: content-box; min-width: var(--readout-w, 9ch); font-variant-numeric: tabular-nums;
  }
  .load-tag { transform: none; box-sizing: content-box; min-width: 7ch; font-variant-numeric: tabular-nums; }
</style>
