---
// A run's result picture: its altitude chart for a motion run, its image, or a big number
// card for a circuit without a plot.
import { picture } from '../lib/images';
import { COLOR, metrics, runImages, type Run } from '../lib/examples';
import { hasFlight } from '../lib/flight';
import FlightChart from './FlightChart.astro';
interface Props { run: Run; sizes: string; eager?: boolean; compact?: boolean; eventsShown?: boolean }
const { run, sizes, eager = false, compact = false, eventsShown = false } = Astro.props;
const flight = hasFlight(run);
const img = runImages(run)[0];
const kinds: Record<string, string> = {
  stress: 'Stress heatmap', temperature: 'Temperature map', waveform: 'Simulated waveform',
  sweep: 'Flame temperature across mixtures', burn: 'Thrust and chamber pressure over the burn',
};
const pic = img && !flight ? picture(img.name) : null;
const [k, v] = metrics(run)[0];
---
{flight ? (
  <FlightChart run={run} compact={compact} spoken={!eventsShown} />
) : pic ? (
  <img class="run-img" src={pic.src} srcset={pic.srcset} sizes={sizes} width={pic.width} height={pic.height}
       loading={eager ? undefined : 'lazy'} decoding="async" alt={`${kinds[img!.kind] ?? img!.kind}. ${run.outcome.headline.replace(/[:;] /g, ', ')}`} />
) : (
  <div class="run-metric" data-verdict={COLOR[run.outcome.verdict] ?? 'marginal'}><p>{v}</p><p>{k}</p></div>
)}
