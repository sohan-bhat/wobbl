---
// A run's result picture: its live 3D scene when the run wrote one, else the playback of a motion run, the bench of a circuit run, its image, or a
// big number card for a run with none of those.
import { picture } from '../lib/images';
import { COLOR, metrics, runImages, type Run } from '../lib/examples';
import { hasSim } from '../lib/sim';
import FlightSim from './FlightSim.astro';
import CircuitBench from './CircuitBench.astro';
import SceneView from './SceneView.astro';
import { sceneFor } from '../lib/scenes';
// controls: a circuit bench's view tabs and pause button, where the picture is not inside a link
interface Props { run: Run; sizes: string; eager?: boolean; compact?: boolean; controls?: boolean }
const { run, sizes, eager = false, compact = false, controls = false } = Astro.props;
const flight = hasSim(run);
const all = runImages(run);
const bench = all.find((i) => i.kind === 'setup');
const img = all.find((i) => i.kind !== 'setup' && i.kind !== 'schematic');
const kinds: Record<string, string> = {
  stress: 'Stress heatmap', temperature: 'Temperature map', waveform: 'Simulated waveform',
  sweep: 'Flame temperature across mixtures', burn: 'Thrust and chamber pressure over the burn',
  frames: 'The mechanism at moments through its move', onset: 'Cell temperature just under and just over the onset',
  modes: 'Mode shapes', mode1: 'First buckling mode', sn: 'Stress cycles against the S-N curve',
  validation: 'Prediction against the test readings',
};
const pic = img && !flight ? picture(img.name) : null;
const [k, v] = metrics(run)[0];
const scene = sceneFor(run.rel);
---
{scene ? (
  <SceneView rel={run.rel} card={compact} />
) : flight ? (
  <FlightSim run={run} compact={compact} answer={false} />
) : bench ? (
  <CircuitBench run={run} setup={bench.name} schematic={all.find((i) => i.kind === 'schematic')?.name}
                controls={controls} />
) : pic ? (
  <img class="run-img" src={pic.src} srcset={pic.srcset} sizes={sizes} width={pic.width} height={pic.height}
       loading={eager ? undefined : 'lazy'} decoding="async" alt={`${kinds[img!.kind] ?? img!.kind}. ${run.outcome.headline.replace(/[:;] /g, ', ')}`} />
) : (
  <div class="run-metric" data-verdict={COLOR[run.outcome.verdict] ?? 'marginal'}><p>{v}</p><p>{k}</p></div>
)}
