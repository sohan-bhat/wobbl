---
// A run's result picture, or a big number card for a circuit without a plot.
import { picture } from '../lib/images';
import { COLOR, metrics, runImages, type Run } from '../lib/examples';
interface Props { run: Run; sizes: string; eager?: boolean }
const { run, sizes, eager = false } = Astro.props;
const img = runImages(run)[0];
const kinds: Record<string, string> = { stress: 'Stress heatmap', temperature: 'Temperature map', waveform: 'Simulated waveform' };
const pic = img ? picture(img.name) : null;
const [k, v] = metrics(run)[0];
---
{pic ? (
  <img class="run-img" src={pic.src} srcset={pic.srcset} sizes={sizes} width={pic.width} height={pic.height}
       loading={eager ? undefined : 'lazy'} decoding="async" alt={`${kinds[img!.kind] ?? img!.kind}. ${run.outcome.headline.replace(/[:;] /g, ', ')}`} />
) : (
  <div class="run-metric" data-verdict={COLOR[run.outcome.verdict] ?? 'marginal'}><p>{v}</p><p>{k}</p></div>
)}
