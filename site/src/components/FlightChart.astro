---
// A motion run's altitude over time, drawn at build time from its trajectory.csv: the line,
// the events Wobbl marked on it and both axes with their units. Labels are HTML over a
// stretched SVG, so they keep their size at every width. The same events are in a table
// for screen readers. scripts/app.ts draws the line in once and adds the pointer readout.
import { flightChart, meters, mps, secs } from '../lib/flight';
import type { Run } from '../lib/examples';
interface Props { run: Run; caption?: string; compact?: boolean; table?: boolean }
// table: the events as a table for screen readers, left out where the page shows them already
const { run, caption, compact = false, table = true } = Astro.props;
const c = flightChart(run);
// a plain caption from the run's own first and last events, such as "from liftoff to landing"
const ev = c.events;
const span = ev.length > 1 ? `Altitude from ${ev[0].name} to ${ev[ev.length - 1].name}` : 'Altitude over the run';
const cap = caption ?? `${span}${c.dryRun ? ', with the same drop without air dashed' : ''}.`;
---
<figure class:list={['fc', { 'fc-compact': compact }]} data-flight={compact ? undefined : ''}>
  <div class="fc-chart" style={`--y-ch: ${c.yChars}`} aria-hidden="true">
    {!compact && <p class="fc-ytitle">Altitude (m)</p>}
    <div class="fc-plot" data-samples={compact ? undefined : c.samples} data-top={c.top} data-tend={c.tEnd}>
      {c.yTicks.map((t, i) => (
        <span class:list={['fc-grid', { 'fc-ground': i === 0 }]} style={`top: ${t.top.toFixed(2)}%`}>
          {!compact && <span class="fc-yt">{t.v}</span>}
        </span>
      ))}
      <span class="fc-draw">
        <svg viewBox="0 0 1000 1000" preserveAspectRatio="none" focusable="false">
          <path class="fc-area" d={c.area} />
          {c.ghost && <path class="fc-ghost" d={c.ghost} vector-effect="non-scaling-stroke" />}
          <path class="fc-line" d={c.line} vector-effect="non-scaling-stroke" />
        </svg>
      </span>
      {!compact && c.xTicks.map((t, i) => (
        <span class="fc-xt" data-edge={i === 0 ? 'start' : t.left > 97 ? 'end' : undefined} style={`left: ${t.left.toFixed(2)}%`}>{t.v}</span>
      ))}
      {c.markers.map((m) => (
        <span class:list={['fc-ev', { 'fc-ev-ghost': m.ghost }]} style={`left: ${m.left.toFixed(2)}%; top: ${m.top.toFixed(2)}%; --at: ${m.at.toFixed(3)}`}>
          {!compact && <span class="fc-ev-l" data-align={m.align} data-lead={m.lead} style={m.label}><b>{m.name}</b><span>{m.detail}</span></span>}
        </span>
      ))}
      {!compact && <span class="fc-cross" hidden><span class="fc-read"></span></span>}
    </div>
    {!compact && <p class="fc-xtitle">Time (s)</p>}
  </div>
  {!compact && table && (
    <table class="visually-hidden">
      <caption>Events marked on the chart</caption>
      <thead><tr><th scope="col">Event</th><th scope="col">Time</th><th scope="col">Altitude</th><th scope="col">Speed</th></tr></thead>
      <tbody>
        {c.events.map((e) => (
          <tr><th scope="row">{e.name}</th><td>{secs(e.t_s)}</td><td>{meters(e.alt_m)}</td><td>{e.speed_mps === undefined ? '' : mps(e.speed_mps)}</td></tr>
        ))}
      </tbody>
    </table>
  )}
  {!compact && <figcaption>{cap}</figcaption>}
</figure>
