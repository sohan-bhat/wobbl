---
// The landing page's motion contrast: the simplest run beside a rich one, each played back from
// the example's own outputs and linked to its page.
import FlightSim from './FlightSim.astro';
import { findRun } from '../lib/examples';
import { url } from '../lib/site';
interface Props { rels: string[] }
const { rels } = Astro.props;
const sides = rels.map((rel) => findRun(rel));
---
<div class="pair">
  {sides.map(({ ex, run }) => (
    <FlightSim run={run} name={{ label: ex.title, href: url(`examples/${ex.name}/`) }} />
  ))}
</div>
