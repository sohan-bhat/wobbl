---
// Every page: head tags, the top bar, the footer and the page transition.
// The top bar and footer persist across navigations; only <main> fades.
import { ClientRouter, fade } from 'astro:transitions';
import '../styles/global.css';
import { REPO, VERSION, fullUrl, url } from '../lib/site';

interface Props {
  title: string;
  description: string;
  path: string;              // route under the base, '' for home
  indexable?: boolean;
  search?: boolean;          // index this page for search
}
const { title, description, path, indexable = true, search = false } = Astro.props;
const nav = [
  { label: 'Docs', href: 'get-started/', section: ['get-started/', 'guides/'] },
  { label: 'Examples', href: 'examples/', section: ['examples/'] },
  { label: 'Validation', href: 'validation/', section: ['validation/'] },
];
const OG_ALT = 'The Wobbl logo next to a stress heatmap of a cast motor mount, peak 124 MPa at the rib tip.';
---
<!doctype html>
<html lang="en" transition:animate="none">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
{indexable ? <link rel="canonical" href={fullUrl(path)}> : <meta name="robots" content="noindex">}
<meta name="theme-color" content="#0e1011">
<meta name="color-scheme" content="dark">
<link rel="icon" href={`${url('favicon.svg')}?v=1`} type="image/svg+xml">
<link rel="icon" href={`${url('favicon-32.png')}?v=1`} sizes="32x32" type="image/png">
<link rel="apple-touch-icon" href={`${url('apple-touch-icon.png')}?v=1`}>
<meta property="og:type" content="website">
<meta property="og:site_name" content="Wobbl">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={fullUrl(path)}>
<meta property="og:image" content={`${fullUrl('og.png')}?v=2`}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content={OG_ALT}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={`${fullUrl('og.png')}?v=2`}>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@100..125,400..800&family=IBM+Plex+Mono:wght@400;500;600&display=swap">
<slot name="head" />
<ClientRouter />
</head>
<body>
<a class="skip" href="#main" data-skip>Skip to content</a>

<header class="nav" transition:persist="nav" transition:name="nav">
  <div class="wrap nav-row">
    <a class="brand" href={url()} aria-label="Wobbl home">
      <img src={`${url('assets/logo-dark.svg')}?v=1`} width="136" height="22" alt="Wobbl">
    </a>
    <nav class="nav-links" aria-label="Main">
      {nav.map((n) => (
        <a href={url(n.href)} data-section={n.section.join(' ')}
           aria-current={path === n.href ? 'page' : undefined}
           class={path !== n.href && n.section.some((s) => path.startsWith(s)) ? 'is-here' : undefined}>{n.label}</a>
      ))}
    </nav>
    <div class="nav-tools">
      <button type="button" class="btn-outline btn-sm nav-search" data-search-open aria-haspopup="dialog">
        <span>Search</span><kbd translate="no">/</kbd>
      </button>
      <span class="nav-version" translate="no" title="Wobbl version">v{VERSION}</span>
      <a class="btn-outline btn-sm nav-gh" href={REPO}>GitHub</a>
    </div>
  </div>
</header>

<main id="main" tabindex="-1" transition:name="main" transition:animate={fade({ duration: '180ms' })}
      data-pagefind-body={search ? '' : undefined}>
  <slot />
</main>

<footer class="footer" transition:persist="footer" transition:name="footer">
  <div class="wrap footer-row">
    <div class="footer-brand">
      <img src={`${url('assets/logo-dark.svg')}?v=1`} width="136" height="22" alt="Wobbl" loading="lazy">
      <p>Simulate anything before you build it. Open source, by Sohan Bhat.</p>
    </div>
    <ul class="footer-links" aria-label="Project">
      <li><a href={`${REPO}/blob/main/CHANGELOG.md`}>Changelog</a></li>
      <li><a href={`${REPO}/issues`}>Issues</a></li>
      <li><a href={`${REPO}/blob/main/LICENSE`}>MIT license</a></li>
    </ul>
  </div>
</footer>

<dialog class="search" id="search-dialog" aria-label="Search the docs" transition:persist="search">
  <div class="search-box">
    <div class="search-head">
      <p class="search-title">Search</p>
      <button type="button" class="btn-outline btn-sm" data-search-close>Close</button>
    </div>
    <div id="search-ui" data-bundle={url('pagefind/')} data-base={url()}></div>
  </div>
</dialog>

<script>
  import '../scripts/app';
</script>
</body>
</html>
