---
// GitHub Pages serves this for any missing path, at any depth, so every link uses the base path.
import Base from '../layouts/Base.astro';
import { url } from '../lib/site';
---
<Base title="Page not found | Wobbl" path="404.html" indexable={false}
      description="There is no page at this address. The Wobbl site has a home page, the docs, the examples and validation.">
  <div class="wrap page notfound">
    <header class="page-head">
      <p class="notfound-code" aria-hidden="true">404</p>
      <h1>Page not found</h1>
      <p class="page-lead">Nothing lives at this address. The docs, the examples and the validation results are all in the menu above.</p>
    </header>
    <p class="notfound-go"><a class="btn" href={url()}>Go to the home page</a></p>
  </div>
</Base>
