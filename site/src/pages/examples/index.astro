---
// The examples gallery: every example with its playback or result image, domain, question and verdict.
import Base from '../../layouts/Base.astro';
import RunImage from '../../components/RunImage.astro';
import SceneView from '../../components/SceneView.astro';
import { viewerScene } from '../../lib/scenes';
import { COLOR, examples, metrics } from '../../lib/examples';
import { url } from '../../lib/site';
const all = examples();
---
<Base title="Examples | Wobbl" path="examples/" search
      description="Real Wobbl runs on rockets, falling bodies, circuits, flames, motors, linkages, robot arms, cells, resonance, buckling, fatigue, printed and cast parts, heat sinks and battery packs, with their reports.">
  <div class="wrap page">
    <nav class="crumbs" aria-label="Breadcrumb"><ol><li><a href={url()}>Home</a></li><li aria-current="page">Examples</li></ol></nav>
    <header class="page-head">
      <h1>Examples</h1>
      <p class="page-lead">Real flights, circuits, flames, mechanisms and parts, each run with Wobbl, and every number here comes from that run’s own output.</p>
    </header>
    <ul class="ex-grid">
      {all.map((ex) => {
        const r = ex.runs[0];
        // the first number among the headline figures, so a card never shows a bare word
        const [, v] = metrics(r).find(([, x]) => /\d/.test(x)) ?? metrics(r)[0];
        const text = (
          <>
            <span class="ex-cat">{ex.domain}</span>
            <span class="ex-title">{ex.title}</span>
            <span class="ex-sub">{ex.subtitle || r.question}</span>
            <span class="ex-v"><span class="vword" data-verdict={COLOR[r.outcome.verdict] ?? 'marginal'}>{r.outcome.verdict.toUpperCase()}</span> {v}</span>
          </>
        );
        return (
          viewerScene(r) ? (
            <li class="ex-card">
              <SceneView rel={r.rel} card label={ex.title} />
              <a class="ex-link" href={url(`examples/${ex.name}/`)}>{text}</a>
            </li>
          ) : (
            <li><a class="ex-card" href={url(`examples/${ex.name}/`)}>
              <RunImage run={r} sizes="(min-width: 1100px) 300px, (min-width: 720px) 45vw, 100vw" compact />
              {text}
            </a></li>
          )
        );
      })}
    </ul>
  </div>
</Base>
