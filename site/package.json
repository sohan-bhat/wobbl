{
  "name": "wobbl-site",
  "private": true,
  "type": "module",
  "description": "The Wobbl website, built with Astro into static files for GitHub Pages.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --port 4321",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview --port 4321"
  },
  "dependencies": {
    "astro": "7.3.4",
    "markdown-it": "14.3.1",
    "three": "0.160.0"
  },
  "devDependencies": {
    "pagefind": "1.5.2"
  }
}
